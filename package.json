{
  "name": "@deathman92/adonis-sail",
  "description": "Generate a ready-to-use docker environment for your Adonis application",
  "version": "0.3.2",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./commands": "./build/commands/main.js",
    "./commands/*": "./build/commands/*.js"
  },
  "scripts": {
    "prepare": "husky",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" --up=\"1\" build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "precompile": "npm run lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postcompile": "npm run copy:templates && npm run index:commands",
    "build": "npm run compile",
    "release": "release-it",
    "version": "npm run build",
    "index:commands": "adonis-kit index build/commands",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "docker",
    "adonis-sail",
    "docker-compose"
  ],
  "author": "deathman92 <deathman2292@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/deathman92/adonis-sail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deathman92/adonis-sail.git"
  },
  "bugs": {
    "url": "https://github.com/deathman92/adonis-sail/issues"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@japa/snapshot": "^2.0.10",
    "@poppinss/ts-exec": "^1.4.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.2",
    "@types/sinon": "^22.0.0",
    "c8": "^11.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.11.0",
    "esmock": "^2.7.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "release-it": "^21.1.0",
    "sinon": "^22.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    }
  },
  "dependencies": {
    "docker-compose": "^1.5.0",
    "yaml": "^2.9.0"
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./commands/sail_add.ts",
      "./commands/sail_start.ts",
      "./commands/sail_status.ts",
      "./commands/sail_stop.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": "@adonisjs/prettier-config"
}
